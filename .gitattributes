# Trellis: append-only developer journals should merge cleanly across
# parallel sessions/worktrees — each session only appends a new block, so
# there is nothing to actually conflict on.
#
# Do NOT add a rule for workspace/*/index.md here — it is fully regenerated
# every session, so a real conflict there is expected and safe to resolve by
# picking either side (task state lives in task.json, not index.md). See
# .trellis/spec/cli/backend/directory-structure.md for details.
.trellis/workspace/*/journal-*.md merge=union

# Files whose bytes are embedded into the binary via `include_str!` must be
# platform-independent: with `core.autocrlf=true` a Windows checkout materialises
# them as CRLF, which (a) puts platform-dependent line endings inside the binary
# and (b) broke a multi-line contract anchor in CI (2026-11-05,
# templates_gate_child_sessions_at_a_single_registration_point on windows-latest).
# Red line 11: assertions may read text content, never the checkout's line endings.
src-tauri/src/agent/hooks/templates/* text eol=lf
# 真实样本夹具（include_str! 进测试）：跨行内容断言要求 LF，Windows checkout 落 CRLF 会让探针挂
src-tauri/src/conversation/adapters/fixtures/* text eol=lf
src-tauri/src/**/*.rs text eol=lf
src-tauri/src/browser/picker_script.js text eol=lf
src/shared/events.ts text eol=lf
src/shared/types/notification.ts text eol=lf
src/shared/utils/agentHookSources.ts text eol=lf
src/features/notification/hooks/useNotificationReflow.ts text eol=lf
